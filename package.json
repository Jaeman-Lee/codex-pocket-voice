{
  "name": "codex-pocket-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first voice interface for controlling Codex CLI safely over SSH.",
  "bin": {
    "codex-voice-bridge": "dist/src/index.js",
    "codex-pocket-web": "dist/src/web-index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "web": "node dist/src/web-index.js",
    "web:dev": "node --import tsx src/web-index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
