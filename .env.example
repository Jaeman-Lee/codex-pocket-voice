# Colon-separated Linux workspace roots.
CODEX_VOICE_ROOTS=/absolute/path/to/project-a:/absolute/path/to/project-b

# Linux Companion identity and project creation location.
CODEX_DEVICE_NAME=My Linux PC
CODEX_PROJECTS_HOME=/absolute/path/to/projects
CODEX_PROJECT_CREATION_ROOTS=/absolute/path/to/projects

# Optional when codex is not on PATH.
# CODEX_BIN=/absolute/path/to/codex

# Mobile web UI always binds to loopback; only the port is configurable.
# CODEX_WEB_PORT=8787

# Authentication state stores device identity and token hashes, never raw tokens.
# CODEX_POCKET_AUTH_STATE=/home/user/.config/codex-pocket-voice/gateway-auth.json

# Android background SSH tunnel (scripts/pc-codex-web.sh).
PC_SSH_TARGET=my-pc
PC_CODEX_WEB_APP=/absolute/path/to/codex-pocket-voice
# PC_PORT=22
# PC_CODEX_KEY=/absolute/path/to/private-key

# Optional local media processing on Linux.
# CODEX_POCKET_MEDIA_DIR=/home/user/.local/state/codex-pocket-voice/media
# CODEX_MEDIA_MAX_BYTES=209715200
# CODEX_VIDEO_ENABLED=true
# CODEX_VIDEO_OLLAMA_BIN=/absolute/path/to/ollama
# CODEX_VIDEO_OLLAMA_URL=http://127.0.0.1:11435
# CODEX_VIDEO_MODEL=qwen3-vl:4b
# CODEX_MEDIA_RESPONSE_LANGUAGE=ko
# CODEX_MEDIA_RETENTION_HOURS=24

# Optional provider binaries and display labels.
# CODEX_ACCOUNT_LABEL=Current Codex CLI account
# CLAUDE_BIN=/absolute/path/to/claude
